# -----------------------------------------------------------------------------
# Environment variables for Nexus CRM
# Copy to `.env` and fill in real values. Never commit `.env`.
# -----------------------------------------------------------------------------

# PostgreSQL connection string used by Prisma (Step 7).
# Example (local): postgresql://postgres:postgres@localhost:5432/nexus_crm?schema=public
# On Vercel, set this in Project Settings → Environment Variables.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/nexus_crm?schema=public"

# Auth.js / NextAuth secret (Step 8). Generate with: npx auth secret
# Required in production for signing session tokens.
AUTH_SECRET="replace-with-a-long-random-string"

# Demo Credentials login (used by src/auth.ts when no DB user is found).
# These let the app be evaluated without a database connected.
AUTH_DEMO_EMAIL="admin@nexus-crm.jp"
AUTH_DEMO_PASSWORD="demo1234"
